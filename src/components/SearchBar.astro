---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

const searchIndex = allPosts.map((post) => ({
  title: post.data.title,
  author: post.data.author,
  tags: post.data.tags,
  slug: post.id,
}));
---

<div class="search-wrap">
  <input
    type="text"
    id="book-search"
    placeholder="buscar por título, autora ou tag (ex: mafia)"
    autocomplete="off"
  />

  <ul id="search-results"></ul>
</div>

<script define:vars={{ searchIndex }}>
  const input = document.getElementById('book-search');
  const results = document.getElementById('search-results');

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();

    results.innerHTML = '';

    // Só pesquisa com 3 ou mais caracteres
    if (q.length < 3) return;

    const matches = searchIndex.filter(
      (post) =>
        post.title.toLowerCase().includes(q) ||
        post.author.toLowerCase().includes(q) ||
        post.tags.some((tag) => tag.toLowerCase().includes(q))
    );

    matches.slice(0, 6).forEach((post) => {
      const li = document.createElement('li');
      const a = document.createElement('a');

      a.href = `/blog/${post.slug}`;
      a.textContent = `${post.title} — ${post.author}`;

      li.appendChild(a);
      results.appendChild(li);
    });

    if (matches.length === 0) {
      const li = document.createElement('li');
      li.classList.add('empty');

      li.innerHTML = `
        <svg class="empty-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span class="empty-text">Nenhuma leitura encontrada com esse termo.</span>
      `;

      results.appendChild(li);
    }
  });

  document.addEventListener('click', (event) => {
    if (!event.target.closest('.search-wrap')) {
      results.innerHTML = '';
    }
  });
</script>

<style is:global>
  .search-wrap {
    position: relative;
    width: 100%;
    margin: 0;
  }

  /* ---------- Campo de busca ---------- */

  #book-search {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 1.1rem;
    border: 1px solid #CDAA78;
    border-radius: 999px;
    background: #FAF6F0;
    color: #4A3F35;
    font-family: "Lora", serif;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #book-search::placeholder {
    color: #8B7A68;
  }

  #book-search:focus {
    border-color: #A97B5D;
    box-shadow: 0 0 0 3px rgba(169, 123, 93, 0.14);
  }

  /* ---------- Dropdown ---------- */

  #search-results {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 0;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    background: #FFFDFB;
    border: 1px solid #E8D9CB;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 24px rgba(74, 63, 53, 0.08);
    z-index: 20;
    box-sizing: border-box;
  }

  #search-results:empty {
    display: none;
  }

  /* ---------- Resultados ---------- */

  #search-results li a {
    display: block;
    padding: 0.75rem 0.9rem;
    font-family: "Lora", serif;
    font-size: 0.85rem;
    color: #4A3F35;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  #search-results li:not(:last-child) a {
    border-bottom: 1px solid #F3E8DE;
  }

  #search-results li a:hover {
    background: #F8EFE6;
  }

  /* ---------- Estado vazio ---------- */

  #search-results li.empty {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 0.9rem;
    background: #FFFDFB;
  }

  .empty-icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    color: #B07A5A;
  }

  .empty-text {
    font-family: "Lora", serif;
    font-size: 0.82rem;
    line-height: 1.4;
    color: #6B5E4F;
  }
</style>