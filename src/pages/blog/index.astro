---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = 'Blog — Bookmark';
const description = 'Todas as resenhas de romance já publicadas no Bookmark.';
---

<html lang="pt-br">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Lora:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <style>
      html, body {
        margin: 0;
        height: 100%;
        background: #FAF6F0;
      }
    </style>
  </head>
  <body class="blog-body">
    <Header />
    <main>
      <div class="page-heading">
        <p class="eyebrow-blog">todas as resenhas</p>
        <h1>Se eu li e amei, está aqui:</h1>
      </div>

      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="post-card">
              <div class="post-text">
                <h2>{post.data.title}</h2>
                <p class="post-author">{post.data.author}</p>
                <div class="post-meta">
                  <FormattedDate date={post.data.pubDate} />
                  <span class="dot">•</span>
                  <span>nota {post.data.nota}/10</span>
                  {post.data.tags?.length > 0 && (
                    <>
                      <span class="dot">•</span>
                      <span class="tags">{post.data.tags.join(', ')}</span>
                    </>
                  )}
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>

      {posts.length === 0 && (
        <p class="empty-state">Ainda não tem nenhuma resenha publicada por aqui.</p>
      )}
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Rodapé sempre grudado no fim, mesmo com pouco conteúdo:
     body vira uma coluna de altura mínima 100vh, main cresce
     pra ocupar o espaço sobrando, footer fica sempre no fim. */
  .blog-body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    max-width: 720px;
    width: 100%;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    box-sizing: border-box;
  }

  .page-heading {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .eyebrow-blog {
    font-family: "Lora", serif;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #A97B5D;
    margin: 0 0 0.4rem;
  }

  h1 {
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-weight: 600;
    font-size: 2.3rem;
    color: #4A3F35;
    margin: 0;
  }

  /* Lista de posts: cresce normalmente até um limite de altura,
     depois ganha rolagem própria com a mesma barrinha do agente. */
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0 4px 0 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 60vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #CDAA78 transparent;
  }

  .post-list::-webkit-scrollbar {
    width: 6px;
  }

  .post-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .post-list::-webkit-scrollbar-thumb {
    background-color: #CDAA78;
    border-radius: 999px;
  }

  .post-list::-webkit-scrollbar-thumb:hover {
    background-color: #A97B5D;
  }

  .post-card {
    display: block;
    padding: 1.25rem 1.5rem;
    background: #F1E4D8;
    border: 1px solid #E3D2C0;
    border-radius: 14px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(74, 63, 53, 0.1);
  }

  .post-text h2 {
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-weight: 600;
    font-size: 1.4rem;
    color: #4A3F35;
    margin: 0 0 0.2rem;
  }

  .post-author {
    font-family: "Lora", serif;
    font-size: 0.85rem;
    color: #8A7A67;
    margin: 0 0 0.5rem;
  }

  .post-meta {
    font-family: "Lora", serif;
    font-size: 0.78rem;
    color: #A97B5D;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .dot {
    opacity: 0.6;
  }

  .tags {
    text-transform: capitalize;
  }

  .empty-state {
    text-align: center;
    font-family: "Lora", serif;
    font-style: italic;
    color: #8A7A67;
  }
</style>