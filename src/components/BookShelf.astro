---
import { getCollection } from 'astro:content';
import BookSpine from './BookSpine.astro';

// paleta mais suave e empoeirada
const palette = ['#9CA98D', '#C79B94', '#CDAA78', '#A97B5D', '#B98C7A'];

const allPosts = await getCollection('blog');
const recent = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<section class="shelf-section">
  <p class="eyebrow">últimas leituras</p>

  <div class="shelf">
    {recent.map((post, i) => (
      <BookSpine
        title={post.data.title}
        author={post.data.author}
        slug={post.id}
        color={palette[i % palette.length]}
      />
    ))}
  </div>
</section>

<style>
  .shelf-section {
    max-width: 360px;
    height: 100%;
    margin: 0;
    padding: 0.25rem 0;
    text-align: center;
    overflow: visible; /* deixa os cantos arredondados aparecerem */
    display: flex;
    flex-direction: column;
  }

  .eyebrow {
    font-family: "Lora", serif;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #A97B5D;
    margin: 0 0 0.25rem;
    flex-shrink: 0;
  }

  h2 {
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-size: 1.7rem;
    color: #4A3F35;
    margin: 0 0 1rem;
    flex-shrink: 0;
  }

  .shelf {
    min-height: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.9rem;
    overflow: visible; /* deixa os cantos arredondados aparecerem */
  }

  @media (max-width: 860px) {
    .shelf-section {
      height: auto;
      overflow: visible;
    }
    .shelf {
      overflow: visible;
      justify-content: flex-start;
    }
  }
</style>
